{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "~*": ["./.github*"],
      "tests*": ["./tests*"]
    }
  },
  "include": [".github/**/*.ts", "tests/**/*.ts"]
}
